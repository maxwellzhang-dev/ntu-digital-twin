# Copy this file to .env.local and fill in your own key.
# Get a free key at https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_ACCOUNT_KEY=""

LTA_DATAMALL_API="https://datamall2.mytransport.sg/ltaodataservice"

# Optional: data.gov.sg API key (free) — raises the anonymous rate limit for PSI / rain / lightning
DATA_GOV_API_KEY=""

# Optional: Google Maps Platform browser key with "Map Tiles API" enabled — turns on the "Real 3D" mode.
# Restrict it to your domains (HTTP referrers) in Google Cloud Console; it is visible to the browser.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
